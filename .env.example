# Copy to .env and replace every placeholder. Never commit .env.
# Generate secrets with:  .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Docker PostgreSQL 16 (docker-compose.yml) ---
POSTGRES_USER=traceforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=traceforge
POSTGRES_HOST_PORT=5433

# --- Traceforge API ---
# Host port 5433 is the Docker container. Port 5432 is a separate native PostgreSQL and is not used.
# Use 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 ::1 first, where the container is not bound.
# The main database. Never a default: used only with `python -m app.serve --database main` (and migrated only with
# `alembic -x database=main -x confirm=traceforge upgrade head`). Its name is also the base of the two below.
DATABASE_URL=postgresql+psycopg://traceforge:change-me@127.0.0.1:5433/traceforge
# Test suite and `--database test`. The name must be exactly <main>_test.
TEST_DATABASE_URL=postgresql+psycopg://traceforge:change-me@127.0.0.1:5433/traceforge_test
# The default for `python -m app.serve` (persistent local data). The name must be exactly <main>_dev.
DEV_DATABASE_URL=postgresql+psycopg://traceforge:change-me@127.0.0.1:5433/traceforge_dev
# The database is chosen per process (`--database dev|test|main`, or the TRACEFORGE_DATABASE environment variable
# for `uvicorn --factory`). TRACEFORGE_DATABASE is deliberately not read from this file.

# Signs session CSRF tokens. At least 32 characters.
TRACEFORGE_SECRET_KEY=replace-with-a-long-random-value
# HMAC pepper for API key hashes. At least 32 characters. Changing it invalidates all API keys.
TRACEFORGE_API_KEY_PEPPER=replace-with-a-different-long-random-value

# Session lifetime and cookie flags. Set COOKIE_SECURE=true when served over HTTPS.
TRACEFORGE_SESSION_TTL_HOURS=168
TRACEFORGE_COOKIE_SECURE=false

# Maximum accepted request body in bytes (default 5 MiB).
TRACEFORGE_MAX_REQUEST_BYTES=5242880
# Comma-separated browser origins allowed by CORS (the Vite dev server). Login and registration also
# reject requests whose Origin is not in this list. Origins are exact: http://127.0.0.1:5173 is a
# different origin from http://localhost:5173.
TRACEFORGE_CORS_ORIGINS=http://localhost:5173
TRACEFORGE_LOG_LEVEL=INFO
# Host names the server answers to (localhost only; anything else is a 400, which also blocks DNS rebinding).
TRACEFORGE_ALLOWED_HOSTS=127.0.0.1,localhost
# The built console served at http://127.0.0.1:8000/ (default: frontend/dist). Empty disables serving.
# TRACEFORGE_FRONTEND_DIST=

# Failed-login rate limiting. In-process only: not shared across workers or hosts (see backend/README.md).
# Failures allowed per (client IP, email), and per client IP across all emails, within the window.
TRACEFORGE_LOGIN_MAX_FAILURES=5
TRACEFORGE_LOGIN_MAX_FAILURES_PER_IP=50
TRACEFORGE_LOGIN_FAILURE_WINDOW_SECONDS=900
# Upper bound on tracked limiter keys (least recently used are evicted).
TRACEFORGE_LOGIN_LIMITER_MAX_KEYS=10000

# Failure diagnosis (M6). "mock" is deterministic and offline; "anthropic" needs the optional anthropic package.
TRACEFORGE_DIAGNOSIS_PROVIDER=mock
# TRACEFORGE_DIAGNOSIS_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=                      # server-side only; never sent to the browser
TRACEFORGE_DIAGNOSIS_PROVIDER_TIMEOUT_SECONDS=60
TRACEFORGE_DIAGNOSIS_PROVIDER_MAX_RETRIES=2
TRACEFORGE_DIAGNOSIS_MAX_CASES=10
TRACEFORGE_DIAGNOSIS_TIME_LIMIT_SECONDS=300

# Controlled experiments (M7): case limit per experiment and time allowed from start to completion.
TRACEFORGE_EXPERIMENT_MAX_CASES=500
TRACEFORGE_EXPERIMENT_TIME_LIMIT_SECONDS=3600

# Recovery of interrupted work (M8): a sweep runs at startup and then every interval (0 = startup only). It fails
# diagnoses and scoring left behind by a crash, and running experiments past their deadline. Grace is how long a
# queued diagnosis or an unlocked scoring may wait before it is considered abandoned.
TRACEFORGE_RECOVERY_INTERVAL_SECONDS=60
TRACEFORGE_STALE_JOB_GRACE_SECONDS=120
