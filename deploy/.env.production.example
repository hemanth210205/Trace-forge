# Production configuration for Traceforge behind Caddy on one Linux server (see DEPLOY.md).
#
# Copy to the repository root as `.env` on the SERVER (not into git):
#   install -m 600 -o traceforge -g traceforge deploy/.env.production.example /opt/traceforge/.env
# then replace every <placeholder>. Never reuse the values from your development .env.
# Generate each secret separately with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- PostgreSQL 16 in Docker (docker-compose.yml), bound to 127.0.0.1 only ---
POSTGRES_USER=traceforge
POSTGRES_PASSWORD=<generate: a long random value>
POSTGRES_DB=traceforge
POSTGRES_HOST_PORT=5433

# The production (main) database. Used only with `python -m app.serve --database main`.
# The password must equal POSTGRES_PASSWORD. URL-encode it if it contains @ : / ? # [ ] or %.
DATABASE_URL=postgresql+psycopg://traceforge:<POSTGRES_PASSWORD>@127.0.0.1:5433/traceforge
# Leave TEST_DATABASE_URL and DEV_DATABASE_URL unset on the server: nothing there may run the test suite
# or the development server.

# --- Secrets (at least 32 characters each; generate each one separately) ---
# Signs session CSRF tokens. Changing it signs everyone out.
TRACEFORGE_SECRET_KEY=<generate>
# HMAC pepper for API key hashes. Changing it invalidates every API key.
TRACEFORGE_API_KEY_PEPPER=<generate>

# --- Public address ---
# The origin browsers use. Redirect URLs for Google/GitHub are <TRACEFORGE_PUBLIC_URL>/api/v1/auth/oauth/<provider>/callback.
TRACEFORGE_PUBLIC_URL=https://<your.domain>
# Host names the server answers to: your domain, plus 127.0.0.1 for local health checks on the server.
TRACEFORGE_ALLOWED_HOSTS=<your.domain>,127.0.0.1
# Browser origins trusted for login and registration (exact match).
TRACEFORGE_CORS_ORIGINS=https://<your.domain>
# Session cookies only over HTTPS. Required in production.
TRACEFORGE_COOKIE_SECURE=true

# --- Reverse proxy ---
# Caddy runs on the same machine and connects over loopback. Only these peers may set X-Forwarded-For /
# X-Forwarded-Proto; everyone else's forwarded headers are ignored.
TRACEFORGE_TRUSTED_PROXIES=127.0.0.1,::1

# --- Who may create accounts (password and Google/GitHub alike) ---
# open | disabled | domain | invite. Start with `invite` or `disabled` and create the first account with
#   python -m app.accounts --database main user create you@example.com --name "Your Name"
TRACEFORGE_REGISTRATION=invite
# Only for TRACEFORGE_REGISTRATION=domain: comma-separated domains, e.g. example.com,team.example.org
# TRACEFORGE_REGISTRATION_DOMAINS=
TRACEFORGE_INVITATION_TTL_DAYS=7

# --- Sign in with Google / GitHub (optional; leave unset to keep the buttons off) ---
# TRACEFORGE_GITHUB_CLIENT_ID=<from your production GitHub OAuth App>
# TRACEFORGE_GITHUB_CLIENT_SECRET=<generated in that app>
# TRACEFORGE_GOOGLE_CLIENT_ID=<...>.apps.googleusercontent.com
# TRACEFORGE_GOOGLE_CLIENT_SECRET=<...>

# --- Limits and logging (defaults shown) ---
TRACEFORGE_SESSION_TTL_HOURS=168
TRACEFORGE_MAX_REQUEST_BYTES=5242880
TRACEFORGE_LOG_LEVEL=INFO
TRACEFORGE_LOGIN_MAX_FAILURES=5
TRACEFORGE_LOGIN_MAX_FAILURES_PER_IP=50
TRACEFORGE_LOGIN_FAILURE_WINDOW_SECONDS=900

# --- Diagnosis provider: the offline "mock" unless you have tested the experimental Anthropic provider ---
TRACEFORGE_DIAGNOSIS_PROVIDER=mock
